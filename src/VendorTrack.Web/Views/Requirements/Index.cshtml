@model IReadOnlyList<VendorTrack.Domain.Entities.ComplianceRequirement>
@{
    ViewData["Title"] = "Requirements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Compliance Requirements</h1>
    <a class="btn btn-primary" asp-action="Create">Add Requirement</a>
</div>

<table class="table table-hover">
    <thead><tr><th>Name</th><th>Description</th><th>Expiry</th><th>Reminder Days</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@(item.RequiresExpiry ? "Yes" : "No")</td>
                <td>@item.ExpiryReminderDays</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
            </tr>
        }
    </tbody>
</table>
