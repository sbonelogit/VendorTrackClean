@model VendorTrack.Web.ViewModels.Vendors.VendorIndexViewModel
@{
    ViewData["Title"] = "Vendors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Vendors</h1>
    <a class="btn btn-primary" asp-action="Create">Add Vendor</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search vendor name, email or registration number" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Company</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vendor in Model.Vendors)
        {
            <tr>
                <td>@vendor.CompanyName<br /><small class="text-muted">@vendor.RegistrationNumber</small></td>
                <td>@vendor.Email</td>
                <td>@vendor.Phone</td>
                <td><span class="badge bg-secondary">@vendor.Status</span></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@vendor.VendorId">Edit</a></td>
            </tr>
        }
    </tbody>
</table>
